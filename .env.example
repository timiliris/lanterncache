# Linux Docker Engine host. Replace all example addresses/paths below.
LAN_INTERFACE=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
# Dedicated unused IP outside your router's DHCP pool.
CACHE_IP=192.168.1.250
UPSTREAM_DNS=9.9.9.9
# Absolute host paths. DATA_ROOT holds private Steam credentials: never commit it.
CACHE_ROOT=/srv/lancache
DATA_ROOT=/srv/lanterncache
CACHE_DISK_SIZE=1000g
MIN_FREE_DISK=100g
CAPACITY_GIB=1000
CACHE_INDEX_SIZE=250m
CACHE_MAX_AGE=365d
# LAN address of the Docker HOST, distinct from CACHE_IP above.
UI_BIND_IP=192.168.1.10
UI_PORT=8088
ALLOWED_ORIGINS=http://192.168.1.10:8088,http://lanterncache.local:8088
HOST_LABEL=LanternCache
TZ=Europe/Brussels
NIGHT_START=1
NIGHT_END=7
# Set image digests here when you want reproducible upgrades.
LANCACHE_IMAGE=lancachenet/monolithic@sha256:37f28b362c939a333f3e4f12aa8ca80604cf75050b2f190d0ad972b2fedce00e
LANCACHE_DNS_IMAGE=lancachenet/lancache-dns@sha256:6e046a40e9f0467b1df97ca2ba9b8b7c0d4404736a349c0f8df11fa212871a03
PREFILL_IMAGE=tpill90/steam-lancache-prefill@sha256:4c940d040ef422abec322a7b5afabe4adcf052f62d39eca5c2d336ffab0eaccc
